# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# Keep the Windows diagnostic launchers usable after checkout on any host.
/scripts/capture_windows_gui_state.cmd text eol=crlf
/scripts/copy_windows_active_log.cmd text eol=crlf

